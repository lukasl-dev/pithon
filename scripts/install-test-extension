#!/usr/bin/env bash
# Install the repository source as Pi's global test extension. The source of
# truth remains this repository; ~/.pi is intentionally a replaceable copy.

set -euo pipefail

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
target_dir="$HOME/.pi/agent/extensions/pi-ipython"
runtime_files=(index.ts kernel-client.ts sidecar.py config.ts settings.ts README.md)

for file in "${runtime_files[@]}"; do
  test -f "$source_dir/$file"
done

rm -rf -- "$target_dir"
mkdir -p -- "$target_dir"
for file in "${runtime_files[@]}"; do
  cp -a -- "$source_dir/$file" "$target_dir/$file"
done

printf 'Installed test extension: %s -> %s\n' "$source_dir" "$target_dir"
